# Strelitzia environment configuration
# Copy to ~/.strelitzia/.env and fill in your values.
# STRELITZIA_* names win; the old APPLYPILOT_* names are still read when they are unset (deprecated, 0.4.x).

# LLM Provider (pick one)
GEMINI_API_KEY=           # Gemini 3.6 Flash (recommended, cheapest)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name for all stages

# Rate limiting & tiered models (rate-limit mitigation)
# Per-model RPM/RPD limits are not set here: the defaults ship in src/strelitzia/config/llm_limits.yaml, and
# ~/.strelitzia/llm_limits.yaml overrides them (LLM_RPM_LIMITS / LLM_RPD_LIMITS JSON here is deprecated).
# LLM_RPM_LIMIT=10            # fallback for models not in llm_limits.yaml (0=disabled); LLM_RPD_LIMIT likewise
# LLM_RPM_WINDOW=60           # Window (seconds) the RPM limit is enforced over
# LLM_DISCOVERY_MODEL=gemini-3.1-flash-lite  # lite: highest free daily quota (default)
# LLM_SCORING_MODEL=gemini-3.1-flash-lite    # lite: scoring is the highest-volume stage
# LLM_EXTRACT_MODEL=gemini-3.1-flash-lite    # default; posting extraction, EXTRACT_BATCH_SIZE (default 5) jobs per request
# LLM_TAILOR_MODEL=gemini-3.6-flash          # best flash model your key lists (quality matters)
# LLM_COVER_MODEL=gemini-3.6-flash           # unset stages fall back to LLM_MODEL, then the default

# OpenCode Zen gateway (zero-cost free models, alternative to Gemini/OpenAI)
# OPENCODE_API_KEY=           # from https://opencode.ai/zen (or leave blank for local `opencode auth`)
# LLM_URL=https://opencode.ai/zen/v1  # only set to override the OpenCode gateway URL

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass

# On a 503 ("model overloaded"), send the request to this model right away instead of retrying
# (Google counts 503s against the free-tier daily quota). Default gemini-3.1-flash-lite; "none" disables.
# LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# LLM_FALLBACK_COOLDOWN=300   # seconds to keep using the fallback after a 503

# Google Drive file library (optional; see README "Google Drive file library")
# DRIVE_SYNC=1                 # move new PDFs to Drive after the tailor and cover stages
# DRIVE_ROOT_FOLDER=Strelitzia # top-level Drive folder (set ApplyPilot to keep a pre-rename folder)

# Job store (optional; see README "Database"). Unset = the SQLite file ~/.strelitzia/strelitzia.db.
# Needs the postgres extra: pip install -e ".[postgres]"
# STRELITZIA_DATABASE_URL=postgresql://strelitzia:<password>@127.0.0.1:5432/strelitzia

# Advanced / per-host settings (optional)
# EXTRACT_BATCH_SIZE=5             # jobs per LLM request in the extract stage (minimum 1)
# LLM_API_KEY=                     # bearer key sent to LLM_URL (local/OpenAI-compatible server); default empty
# STRELITZIA_WEB_DIR=              # built dashboard UI for `strelitzia serve`; default: the bundle shipped in the package
# STRELITZIA_DIR=~/.strelitzia     # app data dir (profile, resume, SQLite DB, this .env; default ~/.strelitzia, else an existing ~/.applypilot); set it in the shell, not here
