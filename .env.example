# Strelitzia environment configuration
# Copy to ~/.strelitzia/.env and fill in your values.
# STRELITZIA_* names win; the old APPLYPILOT_* names are still read when they are unset (deprecated, 0.4.x).

# Claude API (every LLM call). Create a key at https://console.anthropic.com. Put it here, never in the
# environment of an unattended Claude Code runner (claude -p prefers ANTHROPIC_API_KEY over its subscription login).
ANTHROPIC_API_KEY=
LLM_MONTHLY_BUDGET_USD=20     # a run stops before month-to-date spend would pass this; unset or 0 = no limit

# Per-stage model and effort (defaults in src/strelitzia/config/llm_models.yaml)
# LLM_EXTRACT_MODEL=claude-haiku-5-5    # also DISCOVERY, SCORING (Haiku) and TAILOR, COVER (Sonnet)
# LLM_TAILOR_EFFORT=medium              # low | medium | high | xhigh | max

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass

# Google Drive file library (optional; see README "Google Drive file library")
# DRIVE_SYNC=1                 # move new PDFs to Drive after the tailor and cover stages
# DRIVE_ROOT_FOLDER=Strelitzia # top-level Drive folder (set ApplyPilot to keep a pre-rename folder)

# Google sign-in for the dashboard (optional; see agents/DEPLOY.md "Google sign-in"). Login is OFF while
# the client id below is unset: every request then acts as the owner. With it set, only the owner and invited
# emails get in. OAuth client: Google Cloud console > Credentials > OAuth client ID (Web application), with the
# authorized redirect URI {STRELITZIA_PUBLIC_URL}/app/api/auth/callback. Needs the web extra.
# STRELITZIA_GOOGLE_CLIENT_ID=
# STRELITZIA_GOOGLE_CLIENT_SECRET=
# STRELITZIA_SESSION_SECRET=        # long random string that signs the session cookie (required when login is on)
# STRELITZIA_OWNER_EMAIL=           # the owner's Google email (the one account that never needs an invite)
# STRELITZIA_PUBLIC_URL=https://strelitzia.engineerfamily.net   # https here makes the session cookie Secure
# STRELITZIA_TOKEN_KEY=             # Fernet key that encrypts each user's Drive token (Connect Google Drive). Make one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Add the redirect URI {STRELITZIA_PUBLIC_URL}/app/api/drive/callback to the same OAuth client.

# Job store (optional; see README "Database"). Unset = the SQLite file ~/.strelitzia/strelitzia.db.
# Needs the postgres extra: pip install -e ".[postgres]"
# STRELITZIA_DATABASE_URL=postgresql://strelitzia:<password>@127.0.0.1:5432/strelitzia

# Advanced / per-host settings (optional)
# STRELITZIA_WEB_DIR=              # built dashboard UI for `strelitzia serve`; default: the bundle shipped in the package
# STRELITZIA_DIR=~/.strelitzia     # app data dir (profile, resume, SQLite DB, this .env; default ~/.strelitzia, else an existing ~/.applypilot); set it in the shell, not here
