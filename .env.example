# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one)
GEMINI_API_KEY=           # Gemini 3.6 Flash (recommended, cheapest)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name for all stages

# Rate limiting & tiered models (rate-limit mitigation)
# LLM_RPM_LIMIT=12            # Gemini free tier =15 RPM; 12 keeps headroom (0=disabled)
# LLM_RPM_WINDOW=60           # Window (seconds) the RPM limit is enforced over
# LLM_DISCOVERY_MODEL=gemini-2.5-flash-lite  # cheaper for judge/strategy; tailoring keeps gemini-3.6-flash
# LLM_SCORING_MODEL=          # override scoring model (defaults to LLM_MODEL)
# LLM_TAILOR_MODEL=           # override tailoring model (defaults to LLM_MODEL)

# OpenCode Zen gateway (zero-cost free models, alternative to Gemini/OpenAI)
# OPENCODE_API_KEY=           # from https://opencode.ai/zen (or leave blank for local `opencode auth`)
# LLM_URL=https://opencode.ai/zen/v1  # only set to override the OpenCode gateway URL

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
